# Postgres. Production: a Neon connection string (Vercel's Neon integration sets this).
# When unset locally, an in-process PGlite database is stored in ./data/pglite.
DATABASE_URL=postgresql://user:password@your-project.neon.tech/neondb?sslmode=require

# Staff sign-in is locked until both variables are set.
STAFF_PASSWORD=choose-a-long-private-password
STAFF_SESSION_SECRET=replace-with-at-least-32-random-characters

# /pilot-demo prototype: access code shown to the client (also needs STAFF_SESSION_SECRET).
DEMO_ACCESS_CODE=choose-a-demo-code

# Gemini reads customer messages. Without a key the demo uses its built-in keyword parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash,gemini-3.5-flash
