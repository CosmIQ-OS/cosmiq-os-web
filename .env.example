# Local development uses data/enquiries.db when LIBSQL_DATABASE_URL is unset.
# For persistent deployment, configure a remote libSQL/Turso database:
LIBSQL_DATABASE_URL=libsql://your-database.example.com
LIBSQL_AUTH_TOKEN=replace-with-database-token

# Staff sign-in is locked until both variables are set.
STAFF_PASSWORD=choose-a-long-private-password
STAFF_SESSION_SECRET=replace-with-at-least-32-random-characters
